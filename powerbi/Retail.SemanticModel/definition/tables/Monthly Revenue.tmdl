	column 'Invoice count'
		dataType: int64
		formatString: #,0
		lineageTag: c71560b7-92bc-40e3-b6c6-8a6539c37a8e
		summarizeBy: none
		sourceColumn: Invoice count

	partition 'Monthly Revenue' = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Month", "Gross amount", "Provisional net amount", "Invoice count"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Gross amount", type number}, {"Provisional net amount", type number}, {"Invoice count", Int64.Type}})
				in
				    Typed

