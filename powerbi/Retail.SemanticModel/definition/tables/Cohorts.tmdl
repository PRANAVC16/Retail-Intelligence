table Cohorts
	lineageTag: ac9dfa6e-f965-4954-9313-2286cafe0657

	measure Retention = SELECTEDVALUE(Cohorts[Rate])
		formatString: 0.0%
		lineageTag: 6a6175ee-0302-45c1-825a-32a33f90f67d

	column 'First observed purchase month'
		dataType: string
		lineageTag: 4cc24e07-a84a-4327-b20c-f4f51267e71d
		summarizeBy: none
		sourceColumn: First observed purchase month

	column 'Months since first purchase'
		dataType: int64
		formatString: 0
		lineageTag: 8c998eac-4e82-4ff5-87ed-4b7d39864645
		summarizeBy: none
		sourceColumn: Months since first purchase

	column Rate
		dataType: double
		formatString: 0.0%
		lineageTag: 9beb54c2-ef38-40dd-adb6-793b2e965ad1
		summarizeBy: none
		sourceColumn: Rate

	partition Cohorts = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"First observed purchase month", "Months since first purchase", "Rate"}),
				    Typed = Table.TransformColumnTypes(Source, {{"First observed purchase month", type text}, {"Months since first purchase", Int64.Type}, {"Rate", type number}})
				in
				    Typed

