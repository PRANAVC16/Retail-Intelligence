table 'Monthly Revenue'
	lineageTag: 60a4f07c-f85f-4f3a-93b2-5dd9b4961101

	measure 'Gross sales' = SUM('Monthly Revenue'[Gross amount])
		formatString: £#,0.00
		lineageTag: 8cdd5899-4253-4cad-b1f6-9de73ea12622

	measure 'Provisional net' = SUM('Monthly Revenue'[Provisional net amount])
		formatString: £#,0.00
		lineageTag: 23723767-6304-424b-8381-7f0cb9bfeded

	measure 'Purchase invoices' = SUM('Monthly Revenue'[Invoice count])
		formatString: #,0
		lineageTag: f00771ac-48f2-4c47-977a-77a0ebe94748

	column Month
		dataType: string
		lineageTag: 667b3f24-74f3-45f7-bc15-629aa759261b
		summarizeBy: none
		sourceColumn: Month

	column 'Gross amount'
		dataType: double
		formatString: £#,0.00
		lineageTag: c0ef2559-46a1-4eb7-a2ee-26ad62a9ba6f
