table 'Country Revenue'
	lineageTag: d53954e4-4335-4a07-8ac1-40778abc3825

	measure 'Country gross sales' = SUM('Country Revenue'[Gross amount])
		formatString: £#,0.00
		lineageTag: 523a5871-f0d6-4aa5-a434-07f99881584a

	column Country
		dataType: string
		lineageTag: 82ff9001-0b03-4281-af32-3ea105e28f48
		summarizeBy: none
		sourceColumn: Country

	column Month
		dataType: string
		lineageTag: 212435f4-a52e-47c9-81da-d832dd839626
		summarizeBy: none
		sourceColumn: Month

	column 'Gross amount'
		dataType: double
		formatString: £#,0.00
		lineageTag: cc2797e0-cd4f-4b83-afc0-a8bd5d824535
		summarizeBy: none
		sourceColumn: Gross amount

	partition 'Country Revenue' = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Country", "Month", "Gross amount"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Country", type text}, {"Month", type text}, {"Gross amount", type number}})
				in
				    Typed

